# ==========================================
# SRKR Coding Club Frontend: Production Configuration
# Every variable is documented in .env.local.example. Set these in your host's
# environment settings; nothing here depends on a particular platform.
# ==========================================

# Base URL to the Django REST API. The value must end in /api.
# Vercel staging keeps using the Render URL configured in the Vercel project.
# AWS Amplify production sets the same variable in the Amplify console to the
# Lambda Function URL plus /api. Do not commit that environment, and do not
# put passwords or tokens in NEXT_PUBLIC_* variables.
# Amplify example:
# NEXT_PUBLIC_API_BASE_URL=https://bpta2b57zq225e7w7gasmr4mjom0lxqpx.lambda-url.ap-south-1.on.aws/api
# INTERNAL_API_BASE_URL is optional and server-only. When unset, server routes
# use NEXT_PUBLIC_API_BASE_URL.
# Example (Render, used by the existing Vercel deployment):
NEXT_PUBLIC_API_BASE_URL=https://srkrcc-backend.onrender.com/api

# Server-only secret shared with the Django backend (same value as its CLIENT_IP_SHARED_SECRET).
# Lets the backend rate-limit each visitor by their real IP instead of this server's IP.
CLIENT_IP_SHARED_SECRET=

# Hosts next/image may load remote pictures from, comma separated (no scheme).
NEXT_IMAGE_REMOTE_HOSTS=images.unsplash.com

# HSTS: start short (e.g. 3600) while the deployment settles, because browsers cannot be told to
# forget it. 0 turns the header off. See .env.local.example.
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Container platforms: set to true for the standalone server bundle.
OUTPUT_STANDALONE=

# Dynamic-form file uploads go from the browser straight to the storage bucket: its origin(s), space separated
# (e.g. https://my-bucket.s3.ap-south-1.amazonaws.com). Leave empty while uploads are not direct-to-storage.
UPLOAD_CONNECT_SRC=
