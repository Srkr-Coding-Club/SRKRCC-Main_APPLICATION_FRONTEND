# ==========================================================================
# SRKR Coding Club Frontend: environment reference
#
# This file lists every variable the frontend reads. Copy it to `.env.local` for local
# development; for deployments see .env.production.example. Nothing here is tied to one
# hosting platform: moving hosts means changing values, not code.
#
# Variables starting with NEXT_PUBLIC_ are bundled into the browser, so never put a secret
# in one. Blank values fall back to the default noted next to each key.
# ==========================================================================

# Django REST Framework backend API base URL (browser-reachable, so it must be public).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Optional, server-only: address the Next.js server uses to reach Django over an internal
# network (e.g. a Docker service name or cluster DNS) instead of the public URL above.
# Falls back to NEXT_PUBLIC_API_BASE_URL when blank. Never exposed to the browser.
INTERNAL_API_BASE_URL=

# Canonical public address of this site, for metadata, sitemap.xml and robots.txt.
# Blank falls back to https://srkrcc.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret shared with the backend (same value as its CLIENT_IP_SHARED_SECRET).
# Lets the backend rate-limit each visitor by their real IP instead of this server's IP.
CLIENT_IP_SHARED_SECRET=

# Hosts next/image may load remote pictures from, comma separated (no scheme).
# Blank falls back to images.unsplash.com.
NEXT_IMAGE_REMOTE_HOSTS=

# HSTS (Strict-Transport-Security header). It makes browsers refuse plain HTTP for this site for
# HSTS_MAX_AGE_SECONDS, and they cannot be told to forget it early: use a short value such as 3600
# until the deployment is settled, then raise it to 31536000 (one year). 0 turns the header off.
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# Build output. Set to true (or build with DOCKER_BUILD=1) to produce the standalone server
# bundle that container platforms run. Blank keeps the default build.
OUTPUT_STANDALONE=
DOCKER_BUILD=

# Largest single file a form respondent may attach, in MB. Keep it at or below the backend ceiling
# (FORM_UPLOAD_MAX_FILE_BYTES: 4 MB on AWS Lambda, 10 MB elsewhere). Defaults to 4.
# NEXT_PUBLIC_MAX_UPLOAD_MB=4

# Cloudflare Turnstile site key (public by design) for forms that switch on the bot check. The matching secret,
# TURNSTILE_SECRET_KEY, belongs to the backend only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
