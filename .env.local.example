# Django REST Framework Backend API Base URL (browser-reachable — must be public)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Optional: server-only override used by Next.js server code (BFF routes, the proxy,
# and server components) to reach Django over an internal network address (e.g. Docker
# service name or Kubernetes cluster DNS) instead of the public URL above. Falls back
# to NEXT_PUBLIC_API_BASE_URL when unset. Never exposed to the browser.
# INTERNAL_API_BASE_URL=http://django:8000/api

# Canonical Production Site URL for Metadata & Sitemaps
NEXT_PUBLIC_SITE_URL=https://srkrcc.com
