#!/bin/sh
# Frontend Pre-Push Hook
# Prevents pushing broken TypeScript code or failing builds to remote repository

echo "🔍 Running frontend pre-push checks..."

# 1. Fast TypeScript type-checking
echo "  → Checking TypeScript types (tsc --noEmit)..."
if command -v pnpm >/dev/null 2>&1; then
  pnpm run type-check
elif command -v npm >/dev/null 2>&1; then
  npm run type-check
else
  npx tsc --noEmit
fi

STATUS=$?
if [ $STATUS -ne 0 ]; then
  echo "❌ Pre-push check FAILED: TypeScript errors detected."
  echo "Please fix the type errors above before pushing."
  exit 1
fi

# 2. Next.js production build verification
echo "  → Verifying Next.js build..."
if command -v pnpm >/dev/null 2>&1; then
  pnpm run build
elif command -v npm >/dev/null 2>&1; then
  npm run build
else
  npx next build
fi

BUILD_STATUS=$?
if [ $BUILD_STATUS -ne 0 ]; then
  echo "❌ Pre-push check FAILED: Production build failed."
  echo "Please fix the build errors above before pushing."
  exit 1
fi

echo "✅ All frontend pre-push checks passed! Proceeding with push."
exit 0
